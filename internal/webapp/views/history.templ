package views

import (
	"fmt"
	"github.com/fitz123/mcduck-wallet/internal/database"
)

templ TransactionHistory(transactions []database.Transaction, nextOffset int, hasMore bool) {
	<main data-page="history">
		<h2>Transaction History</h2>
		<div id="transaction-list">
			for _, t := range transactions {
				@transactionItem(t)
			}
			if hasMore {
				@scrollTrigger(nextOffset)
			}
		</div>
		<div>
			<button hx-get="/dashboard" hx-target="body">
				Back to Balances
			</button>
		</div>
	</main>
}

// TransactionItems renders just the transaction items for infinite scroll
templ TransactionItems(transactions []database.Transaction, nextOffset int, hasMore bool) {
	for _, t := range transactions {
		@transactionItem(t)
	}
	if hasMore {
		@scrollTrigger(nextOffset)
	}
}

templ scrollTrigger(nextOffset int) {
	<div
		hx-get={ fmt.Sprintf("/history?offset=%d", nextOffset) }
		hx-trigger="revealed"
		hx-swap="outerHTML"
	>
		<small class="secondary">Loading more...</small>
	</div>
}

templ transactionItem(t database.Transaction) {
	<article style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
		<!-- Left side: description and date -->
		<div style="min-width: 0; flex: 1;">
			<div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
				<strong>
					@transactionDescriptionHTML(t)
				</strong>
			</div>
			<small class="secondary">
				{ t.Timestamp.Format("2 Jan, 3:04 PM") }
			</small>
		</div>
		<!-- Right side: amount -->
		<strong style="flex-shrink: 0;" class={ ternary(t.Amount >= 0, "text-success", "text-error") }>
			{ fmt.Sprintf("%.2f", t.Amount) } { t.Balance.Currency.Code }
		</strong>
	</article>
}

templ transactionDescriptionHTML(t database.Transaction) {
	switch t.Type {
		case "transfer_out", "transfer_in":
			{ t.FromUsername } → { t.ToUsername }
		case "exchange_out":
			Exchange (out)
		case "exchange_in":
			Exchange (in)
		case "admin_set_balance":
			{ t.FromUsername } SET { t.ToUsername }
		default:
			System
	}
}
