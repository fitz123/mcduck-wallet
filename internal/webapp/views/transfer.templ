// File: pkg/webapp/views/transfer.templ
package views

import (
	"fmt"
	"github.com/fitz123/mcduck-wallet/internal/database"
)

templ TransferForm(balances []database.Balance, previousRecipients []string, user *database.User) {
	<main data-page="transfer">
		<header>
			<h2>Transfer Form</h2>
		</header>
		<form hx-post="/transfer" hx-target="body" hx-confirm="Are you sure you want to make this transfer?">
			<label for="to_username">
				Recipient Username
				<input type="text" id="to_username" name="to_username" placeholder="@username" list="previous-recipients" required/>
				<datalist id="previous-recipients">
					for _, username := range previousRecipients {
						<option value={ "@" + username }></option>
					}
				</datalist>
			</label>
			<label for="amount">
				Amount
				<input type="number" id="amount" name="amount" min="0.01" step="0.01" required/>
			</label>
			<label for="currency">
				Currency
				<select id="currency" name="currency" required>
					for _, balance := range balances {
						<option
							value={ balance.Currency.Code }
							selected?={ user.LastUsedCurrencyID == balance.Currency.ID }
						>
							{ balance.Currency.Name } ({ balance.Currency.Code }) - Balance: { fmt.Sprintf("%.2f", balance.Amount) }
						</option>
					}
				</select>
			</label>
			<label for="note">
				Note (optional)
				<textarea id="note" name="note" maxlength="200" placeholder="Add a message..." rows="2"></textarea>
			</label>
			<button type="submit">Confirm Transfer</button>
		</form>
	</main>
}
